# Stub values for the mocked Playwright suite (npm run build:e2e).
# These hosts do not exist: every request to them is intercepted in e2e/mocked.
# Also a useful template for your own .env.
VITE_API_BASE_URL=https://api.e2e.test
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key
